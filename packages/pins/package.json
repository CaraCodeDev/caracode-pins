{
  "name": "@caracode/pins",
  "version": "0.0.0",
  "description": "Astro dev-toolbar app for pinning notes onto elements in local dev.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "astro-integration",
    "astro",
    "dev-toolbar"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./toolbar": {
      "types": "./dist/toolbar/app.d.ts",
      "default": "./dist/toolbar/app.js"
    }
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "astro": "^7.3.4",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "^0.4.1",
    "magic-string": "^1.4.1"
  }
}
